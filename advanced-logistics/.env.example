# ============================================================
# AILMS Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# This file IS committed to Git as a reference.
# .env files with real values are .gitignored.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Frontend (browser-safe, Vite-prefixed) ---
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Backend Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (BACKEND ONLY — NEVER use VITE_ prefix)
# Retrieve from: Supabase Dashboard → Project Settings → API → service_role / secret
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Prisma) ---
# Transaction pooler (port 6543) — application runtime
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — Prisma migrations
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- CORS ---
FRONTEND_URL=http://localhost:3000
